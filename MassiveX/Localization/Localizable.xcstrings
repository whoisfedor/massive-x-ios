            "state": "translated",
            "value": "El envío Mainnet aún no está publicado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主网发送功能尚未发布"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainnet-Senden noch nicht freigegeben"
