          "stringUnit": {
            "state": "translated",
            "value": "Mainnet read-only preview. Sending is unavailable; this is not a production-ready wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préversion Mainnet en lecture seule. Envoi indisponible ; ce portefeuille n’est pas prêt pour la production."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительная версия Mainnet только для чтения. Отправка недоступна; кошелёк не готов к промышленной эксплуатации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa Mainnet de solo lectura. Envío no disponible; no es una cartera lista para producción."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主网只读预览。发送不可用；此钱包尚未就绪用于生产。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainnet-Vorschau mit Lesezugriff. Senden nicht verfügbar; keine produktionsreife Wallet."
          }
        }
      }
    },
    "YAML import unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YAML import unavailable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Import YAML indisponible"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт YAML недоступен"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importación YAML no disponible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YAML 导入不可用"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YAML-Import nicht verfügbar"
          }
        }
      }
    },
    "Massa's encrypted V0/V1 schema was identified, but native YAML decoding and password-decryption interoperability are not yet verified. Use private-key import instead. No file is read or uploaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Massa's encrypted V0/V1 schema was identified, but native YAML decoding and password-decryption interoperability are not yet verified. Use private-key import instead. No file is read or uploaded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schéma chiffré V0/V1 de Massa a été identifié, mais le décodage YAML natif et le déchiffrement par mot de passe ne sont pas encore vérifiés. Importez plutôt la clé privée. Aucun fichier n’est lu ou envoyé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованная схема Massa V0/V1 определена, но совместимость нативного декодирования YAML и расшифровки паролем ещё не проверена. Используйте импорт приватного ключа. Файлы не читаются и не загружаются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se identificó el esquema cifrado Massa V0/V1, pero no se verificó la interoperabilidad del YAML nativo ni del descifrado con contraseña. Use la importación de clave privada. No se lee ni sube ningún archivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已识别 Massa 加密 V0/V1 格式，但原生 YAML 解码及密码解密兼容性尚未验证。请改用私钥导入。不读取或上传任何文件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Massas verschlüsseltes V0/V1-Schema ist bekannt, native YAML-Dekodierung und Passwortentschlüsselung sind aber noch nicht interoperabel verifiziert. Verwenden Sie den privaten Schlüsselimport. Keine Datei wird gelesen oder hochgeladen."
          }
        }
      }
    },
    "Wallet added. Save a private backup before relying on it. Transfers remain unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet added. Save a private backup before relying on it. Transfers remain unavailable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portefeuille ajouté. Sauvegardez-le en privé avant de vous y fier. Transferts toujours indisponibles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк добавлен. Сохраните приватную резервную копию, прежде чем полагаться на него. Переводы пока недоступны."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartera añadida. Guarde una copia privada antes de depender de ella. Las transferencias siguen no disponibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包已添加。依赖使用前请保存私密备份。转账仍不可用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet hinzugefügt. Erstellen Sie eine private Sicherung, bevor Sie sich darauf verlassen. Überweisungen bleiben nicht verfügbar."
          }
        }
      }
    },
    "This address already exists. Its key and metadata were not changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address already exists. Its key and metadata were not changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse existe déjà. Clé et métadonnées inchangées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес уже существует. Его ключ и метаданные не изменены."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección ya existe. No se cambió su clave ni sus metadatos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地址已存在。其密钥及元数据未更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse existiert bereits. Schlüssel und Metadaten unverändert."
          }
        }
      }
    },
    "The wallet list could not be read. Existing keys were not changed. Restore public metadata before adding wallets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallet list could not be read. Existing keys were not changed. Restore public metadata before adding wallets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des portefeuilles est illisible. Clés existantes inchangées. Restaurez les métadonnées publiques avant d’ajouter des portefeuilles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать список кошельков. Существующие ключи не изменены. Восстановите публичные метаданные перед добавлением."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la lista de carteras. Las claves existentes no cambiaron. Restaure los metadatos públicos antes de añadir carteras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取钱包列表。现有密钥未更改。添加钱包前请恢复公共元数据。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet-Liste konnte nicht gelesen werden. Bestehende Schlüssel unverändert. Stellen Sie öffentliche Metadaten vor dem Hinzufügen wieder her."
          }
        }
      }
    },
    "Previous wallet metadata could not be read. Nothing was deleted or promoted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous wallet metadata could not be read. Nothing was deleted or promoted."
