    "Select an owned Mainnet wallet first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an owned Mainnet wallet first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez d’abord un portefeuille Mainnet détenu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите собственный кошелёк Mainnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione primero una cartera Mainnet propia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择自有主网钱包。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zuerst eine eigene Mainnet-Wallet."
          }
        }
      }
    },
    "This is a watch-only address. No signing key is stored for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a watch-only address. No signing key is stored for it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse est en observation seule. Aucune clé de signature n’est stockée pour elle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это адрес только для наблюдения. Ключ подписи для него не хранится."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección es de solo observación. No se almacena ninguna clave de firma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地址仅供观察，未存储其签名密钥。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Beobachtungsadresse. Dafür ist kein Signaturschlüssel gespeichert."
          }
        }
      }
    },
    "Archived preview accounts cannot send or be funded. Keep any independent backup; create a new Mainnet wallet instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived preview accounts cannot send or be funded. Keep any independent backup; create a new Mainnet wallet instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes de préversion archivés ne peuvent ni envoyer ni être approvisionnés. Gardez votre sauvegarde indépendante et créez un nouveau portefeuille Mainnet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивные предварительные аккаунты не могут отправлять средства или пополняться. Сохраните независимую резервную копию и создайте новый кошелёк Mainnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas de vista previa archivadas no pueden enviar ni recibir fondos. Conserve su copia independiente y cree una cartera Mainnet nueva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档预览账户不能发送或充值。请保留独立备份，并创建新的主网钱包。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Vorschaukonten dürfen weder senden noch Einzahlungen erhalten. Bewahren Sie unabhängige Sicherungen auf und erstellen Sie eine neue Mainnet-Wallet."
          }
        }
      }
    },
    "This wallet record cannot establish a valid signing identity. Do not send from it. Keep your independent backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet record cannot establish a valid signing identity. Do not send from it. Keep your independent backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier ne permet pas d’établir une identité de signature valide. N’envoyez rien depuis ce compte. Gardez votre sauvegarde indépendante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись кошелька не подтверждает корректную идентичность для подписи. Не отправляйте с него средства. Сохраните независимую резервную копию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro no establece una identidad de firma válida. No envíe desde esta cartera. Conserve su copia independiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此钱包记录不能确定有效的签名身份。请勿从中发送，并保留独立备份。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wallet-Datensatz belegt keine gültige Signaturidentität. Senden Sie nicht daraus. Bewahren Sie Ihre unabhängige Sicherung auf."
          }
        }
      }
    },
    "This wallet has owned-account metadata, but this release has no authenticated submission and restart-safe confirmation coordinator. Independent security review is pending. Key access has not been checked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet has owned-account metadata, but this release has no authenticated submission and restart-safe confirmation coordinator. Independent security review is pending. Key access has not been checked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce portefeuille possède des métadonnées de compte détenu, mais cette version ne gère pas la soumission authentifiée et la confirmation sûre après redémarrage. L’examen de sécurité indépendant reste à faire. L’accès à la clé n’a pas été vérifié."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк имеет метаданные собственного аккаунта, но в этой версии нет координатора аутентифицированной отправки и безопасного подтверждения после перезапуска. Независимая проверка безопасности не завершена. Доступ к ключу не проверялся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartera tiene metadatos de cuenta propia, pero esta versión carece de envío autenticado y coordinación segura de confirmación tras reinicios. La revisión de seguridad independiente está pendiente. No se comprobó el acceso a la clave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此钱包有自有账户元数据，但此版本没有经过认证的提交及重启后安全确认协调器。独立安全审查尚未完成。未检查密钥访问。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet hat Metadaten eines eigenen Kontos, aber diese Version hat keinen authentifizierten Übermittlungs- und neustartsicheren Bestätigungskoordinator. Unabhängige Sicherheitsprüfung steht aus. Schlüsselzugriff wurde nicht geprüft."
          }
        }
      }
    },
    "Re-importing this wallet will not enable sending. Keep your backup and wait for a release with verified submission recovery and completed security review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-importing this wallet will not enable sending. Keep your backup and wait for a release with verified submission recovery and completed security review."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réimporter ce portefeuille n’activera pas l’envoi. Gardez votre sauvegarde et attendez une version avec reprise de soumission vérifiée et examen de sécurité terminé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторный импорт не включит отправку. Сохраните резервную копию и дождитесь версии с проверенным восстановлением отправки и завершённой проверкой безопасности."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimportar esta cartera no habilita el envío. Conserve su copia y espere una versión con recuperación de envío verificada y revisión de seguridad completada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新导入不会启用发送。请保留备份，等待具备已验证提交恢复及完成安全审查的版本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneuter Import aktiviert das Senden nicht. Bewahren Sie Ihre Sicherung auf und warten Sie auf eine Version mit verifizierter Wiederaufnahme und abgeschlossener Sicherheitsprüfung."
          }
        }
      }
    },
    "History connection unavailable. Check your connection and retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History connection unavailable. Check your connection and retry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à l’historique indisponible. Vérifiez la connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к истории. Проверьте соединение и повторите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión al historial. Compruebe la conexión y reintente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接历史服务。请检查连接并重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlaufsverbindung nicht verfügbar. Verbindung prüfen und erneut versuchen."
          }
        }
      }
    },
    "History request timed out. Retry when connected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History request timed out. Retry when connected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête d’historique a expiré. Réessayez une fois connecté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истекло время запроса истории. Повторите при наличии связи."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consulta del historial agotó el tiempo. Reintente con conexión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
