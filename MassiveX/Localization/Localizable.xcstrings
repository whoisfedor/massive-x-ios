    "Receive only assets supported on Massa Mainnet. Verify the full address with the sender. The address itself does not encode a network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive only assets supported on Massa Mainnet. Verify the full address with the sender. The address itself does not encode a network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez uniquement des actifs pris en charge sur Massa Mainnet. Vérifiez l’adresse complète avec l’expéditeur. L’adresse ne précise pas le réseau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте только активы, поддерживаемые в Massa Mainnet. Сверьте полный адрес с отправителем. Сам адрес не кодирует сеть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reciba solo activos admitidos en Massa Mainnet. Verifique la dirección completa con el remitente. La dirección no codifica una red."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅接收 Massa 主网支持的资产。请与发送方核对完整地址。地址本身不包含网络信息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfangen Sie nur auf Massa Mainnet unterstützte Werte. Prüfen Sie die vollständige Adresse mit dem Absender. Die Adresse selbst enthält kein Netzwerk."
          }
        }
      }
    },
    "Watch-only: this app does not possess the key or establish that you control this address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-only: this app does not possess the key or establish that you control this address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observation : cette app ne détient pas la clé et ne prouve pas votre contrôle de cette adresse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только наблюдение: у приложения нет ключа, и оно не подтверждает ваш контроль над адресом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo observación: la aplicación no posee la clave ni demuestra que usted controle esta dirección."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅观察：此应用不持有密钥，也不能证明您控制此地址。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur beobachten: Die App besitzt den Schlüssel nicht und bestätigt nicht Ihre Kontrolle über diese Adresse."
          }
        }
      }
    },
