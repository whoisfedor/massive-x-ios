    "Creates a native Massa keypair. Save its private-key backup afterward. No recovery phrase is generated.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a native Massa keypair. Save its private-key backup afterward. No recovery phrase is generated."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une paire de clés Massa native. Sauvegardez ensuite la clé privée. Aucune phrase de récupération n’est générée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт нативную пару ключей Massa. После этого сохраните резервную копию приватного ключа. Фраза восстановления не создаётся."
          }
        },
        "es": {
          "stringUnit": {
