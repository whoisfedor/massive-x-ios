    "History and execution labels are provided by the official explorer indexer, not independently verified consensus proofs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History and execution labels are provided by the official explorer indexer, not independently verified consensus proofs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique et les états d’exécution viennent de l’indexeur officiel, pas de preuves de consensus vérifiées indépendamment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Историю и статусы исполнения предоставляет индексатор официального обозревателя, а не независимо проверенные доказательства консенсуса."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial y los estados proceden del indexador oficial, no de pruebas de consenso verificadas independientemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史及执行状态由官方浏览器索引器提供，并非独立验证的共识证明。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf und Ausführungsstatus stammen vom offiziellen Explorer-Indexer, nicht aus unabhängig geprüften Konsensnachweisen."
          }
        }
      }
    },
