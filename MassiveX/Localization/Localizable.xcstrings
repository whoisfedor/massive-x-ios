    "The network reported final execution failure. Check transaction details before making a new payment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network reported final execution failure. Check transaction details before making a new payment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau signale un échec définitif de l’exécution. Vérifiez les détails avant un nouveau paiement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть сообщила об окончательном сбое исполнения. Проверьте детали операции перед новым платежом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red informó de un fallo final de ejecución. Revisa los detalles antes de otro pago."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络报告执行最终失败。再次付款前请查看交易详情。"
          }
        },
