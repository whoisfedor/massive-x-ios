    "Supports official single-account Version 1 encrypted YAML. Your password stays on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports official single-account Version 1 encrypted YAML. Your password stays on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend en charge le YAML chiffré officiel Version 1 à compte unique. Votre mot de passe reste sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживается официальный зашифрованный YAML версии 1 с одним аккаунтом. Пароль остаётся на этом устройстве."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible con YAML cifrado oficial de versión 1 con una sola cuenta. Tu contraseña permanece en este dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持官方单账户版本 1 加密 YAML。密码仅在此设备上使用。"
