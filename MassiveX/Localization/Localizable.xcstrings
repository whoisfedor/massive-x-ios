          }
        }
      }
    },
    "A native Massa Mainnet read-only wallet with protected local key management. No sample balance or transaction data is displayed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A native Massa Mainnet read-only wallet with protected local key management. No sample balance or transaction data is displayed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portefeuille natif Massa Mainnet en lecture seule avec clés locales protégées. Aucun solde ni opération d’exemple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативный кошелёк Massa Mainnet только для чтения с защищёнными локальными ключами. Примерные балансы и транзакции не отображаются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartera nativa Massa Mainnet de lectura con claves locales protegidas. No se muestran saldos ni transacciones ficticias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Massa 主网只读钱包，提供受保护的本地密钥管理。不显示示例余额或交易。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Massa-Mainnet-Wallet mit Lesezugriff und geschützten lokalen Schlüsseln. Keine Beispielguthaben oder -transaktionen."
          }
        }
      }
    },
    "Receive uses the selected public Mainnet address. Transfers, signing and mnemonics remain unavailable. Preview accounts from earlier versions are archived as unsafe, with secrets preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive uses the selected public Mainnet address. Transfers, signing and mnemonics remain unavailable. Preview accounts from earlier versions are archived as unsafe, with secrets preserved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réception utilise l’adresse publique Mainnet sélectionnée. Transferts, signature et mnémoniques restent indisponibles. Les anciens comptes de préversion sont archivés comme non sûrs, avec clés conservées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получение использует выбранный публичный адрес Mainnet. Переводы, подпись и мнемоники пока недоступны. Прежние аккаунты архивированы как небезопасные, их ключи сохранены."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibir usa la dirección pública Mainnet seleccionada. Transferencias, firma y mnemónicos siguen no disponibles. Cuentas previas archivadas como inseguras, conservando sus claves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收使用所选主网公共地址。转账、签名与助记词仍不可用。早期预览账户已标为不安全并归档，其密钥保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfang nutzt die ausgewählte öffentliche Mainnet-Adresse. Überweisungen, Signieren und Mnemonik bleiben nicht verfügbar. Frühere Vorschaukonten sind als unsicher archiviert, ihre Schlüssel bleiben erhalten."
          }
        }
      }
    },
