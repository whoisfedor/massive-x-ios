    },
    "Enter a supported AU recipient. Public unsafe test addresses are not allowed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a supported AU recipient. Public unsafe test addresses are not allowed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse AU prise en charge. Les adresses de test publiques non sûres sont interdites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите поддерживаемый адрес AU получателя. Небезопасные публичные тестовые адреса запрещены."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una dirección AU compatible. No se permiten direcciones públicas de prueba inseguras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入支持的 AU 收款地址。不允许使用不安全的公开测试地址。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine unterstützte AU-Empfängeradresse ein. Unsichere öffentliche Testadressen sind nicht zulässig."
          }
        }
      }
    },
    "Recipient credit": {
      "localizations": {
