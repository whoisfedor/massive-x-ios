    "Transaction signing and safe submission recovery are not yet verified. No funds can be sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction signing and safe submission recovery are not yet verified. No funds can be sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature et la récupération sûre après soumission ne sont pas encore vérifiées. Aucun fonds ne peut être envoyé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписание и безопасное восстановление после отправки ещё не проверены. Отправка средств невозможна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma y la recuperación segura del envío aún no están verificadas. No se pueden enviar fondos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
