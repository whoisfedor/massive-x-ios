          }
        }
      }
    },
    "Read-only tracking. No key, signing or backup capability. Addresses do not encode a network; all queries stay on Mainnet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only tracking. No key, signing or backup capability. Addresses do not encode a network; all queries stay on Mainnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi en lecture seule. Aucune clé, signature ou sauvegarde. L’adresse ne précise pas le réseau ; toutes les requêtes restent sur Mainnet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только наблюдение. Нет ключа, подписи или резервного копирования. Адрес не кодирует сеть; все запросы остаются в Mainnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimiento de solo lectura. Sin clave, firma ni copia. Las direcciones no codifican red; todas las consultas permanecen en Mainnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读观察，无密钥、签名或备份能力。地址不包含网络信息；所有查询仅访问主网。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Lesezugriff. Kein Schlüssel, Signieren oder Sichern. Adressen enthalten kein Netzwerk; alle Abfragen bleiben im Mainnet."
          }
        }
      }
    },
