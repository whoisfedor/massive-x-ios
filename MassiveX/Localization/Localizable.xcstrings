    "Opens an external website. No wallet connection or signing is performed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens an external website. No wallet connection or signing is performed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un site externe. Aucune connexion du portefeuille ni signature n’est effectuée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает внешний сайт. Подключение кошелька и подписание не выполняются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un sitio externo. No se conecta la cartera ni se firma nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开外部网站。不会连接钱包或执行签名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine externe Website. Keine Wallet-Verbindung oder Signatur wird ausgeführt."
          }
        }
      }
    },
    "External services have their own terms and privacy practices. Listing is not an endorsement or an integrated wallet feature.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External services have their own terms and privacy practices. Listing is not an endorsement or an integrated wallet feature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services externes ont leurs propres conditions et pratiques de confidentialité. Leur présence ne constitue ni une approbation ni une fonctionnalité intégrée au portefeuille."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У внешних сервисов свои условия и правила конфиденциальности. Наличие в списке не означает одобрение или интеграцию с кошельком."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios externos tienen sus propias condiciones y prácticas de privacidad. Su inclusión no supone respaldo ni una función integrada en la cartera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部服务有各自的条款和隐私惯例。列出服务不代表认可，也不代表钱包已集成该功能。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe Dienste haben eigene Bedingungen und Datenschutzpraktiken. Die Auflistung bedeutet weder eine Empfehlung noch eine integrierte Wallet-Funktion."
          }
        }
      }
    },
