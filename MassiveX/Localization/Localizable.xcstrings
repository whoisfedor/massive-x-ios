            "state": "translated",
            "value": "Use a comma or dot for decimals. Thousands separators are not supported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une virgule ou un point pour les décimales. Les séparateurs de milliers ne sont pas acceptés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для дробной части используйте запятую или точку. Разделители тысяч не поддерживаются."
          }
        },
        "es": {
